
RewriteEngine On

RewriteBase /Trabalhos/3K/elyon/

# Encaminha a página inicial para o front controller
RewriteRule ^$ php/index.php [QSA,L]

# Não reescreve arquivos existentes
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Encaminha as demais URLs para o front controller
RewriteRule ^(.*)/?$ php/index.php?url=$1 [QSA,L]
